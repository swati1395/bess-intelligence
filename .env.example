# BESS Market Intelligence System — environment template
# Copy this file to `.env` and fill in the values. .env is git-ignored;
# .env.example (this file) is safe to commit.

# --- Module 2: Claude API extraction ---
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Module 3: Email alerts (Gmail SMTP) ---
# Setup steps (full instructions are at the top of alerts/email_digest.py):
#   1. Enable 2-Step Verification on the sender Gmail account:
#      https://myaccount.google.com/security
#   2. Generate an App Password (NOT your account password):
#      https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password below (spaces optional).
#
# The sender and recipient can be the same address if you want alerts to land
# in the inbox you're sending from. A dedicated alert mailbox is recommended.

GMAIL_SENDER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
ALERT_RECIPIENT=where.to.send@example.com
